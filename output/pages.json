{
  "app": "https://app.loopyloyalty.com",
  "api_base": "https://api.loopyloyalty.com",
  "framework": "AngularJS + ui-router SPA",
  "test_campaign": {"id": "wI4XeFr6rHCTUHGOEFazZ", "name": "COUNCIL TEST", "status": 1},
  "common_api_endpoints": [
    "GET /account",
    "GET /campaigns",
    "GET /campaign/id/:id",
    "GET /campaign/public/:id",
    "GET /subusers",
    "GET /locations",
    "GET /images/stampTemplates",
    "GET /card/cid/:campaignId?count=",
    "GET /events/analytics/all/:campaignId?groupBy=",
    "GET /events/analytics/stampTotals/:campaignId",
    "GET /events/pushHistory/:campaignId",
    "POST /events/analytics/transactions/:campaignId"
  ],
  "router_states": {
    "auth": ["/login", "/renew-subscription", "/verify/:code", "/forgot-password", "/reset-password/:username/:code"],
    "signup_setup": ["/signup", "/get-started", "/setup", "/account"],
    "public": ["/landing-page/:campaignId", "/stamp"],
    "container": ["/dash", "/help", "/manage-my-cards", "/settings", "/subusers", "/subuser/:subuserId", "/invoice/:invoiceId", "/csv-verify/:file", "/404"],
    "edit": ["/edit/:campaignId/design", "/edit/:campaignId/details", "/edit/:campaignId/locations", "/edit/:campaignId/data", "/edit/:campaignId/labels", "/edit/:campaignId/support"],
    "campaign": ["/customers/:campaignId", "/customers/:campaignId/profile/:cardId", "/insights/:campaignId", "/messages/:campaignId", "/overview/:campaignId"]
  },
  "pages": [
    {"name": "Manage My Cards", "url": "/manage-my-cards", "nav": "landing / top-bar cards icon / rail My Cards",
     "purpose": "List card campaigns; entry to editor",
     "features": [
       {"name": "Card tiles", "type": "table", "does": "Shows pass preview, name, draft status per campaign", "entities": ["campaign"]},
       {"name": "MANAGE", "type": "action button", "does": "Opens card editor design tab", "entities": ["campaign"]},
       {"name": "DELETE", "type": "action button", "does": "Deletes campaign", "entities": ["campaign"]},
       {"name": "Create New Card", "type": "action button", "does": "Opens /edit/new/design", "entities": ["campaign"]}],
     "api": ["GET /campaigns"], "links": ["/edit/:id/design", "/settings"], "screenshot": "screenshots/manage-my-cards.png"},
    {"name": "Card Editor - Design", "url": "/edit/:campaignId/design", "nav": "MANAGE or Create New Card",
     "purpose": "Design the stamp card pass",
     "features": [
       {"name": "Type", "type": "radio", "does": "Single vs Multi Reward", "entities": ["campaign"]},
       {"name": "Images", "type": "form", "does": "Icon (87x87) and Logo (480x150) uploads", "entities": ["campaign.design"]},
       {"name": "Stamps", "type": "form", "does": "Count 1-30; pick/upload stamped & unstamped images", "entities": ["campaign.stamps"]},
       {"name": "Colors", "type": "form", "does": "Card/Background/Stamp Circle/Stamp color pickers", "entities": ["campaign.design"]},
       {"name": "Customer view preview", "type": "chart", "does": "Live pass preview with carousel", "entities": ["campaign"]},
       {"name": "Save / Save & Preview / Activate", "type": "action button", "does": "Persist draft / activate campaign", "entities": ["campaign"]}],
     "api": ["GET /campaign/id/:id"], "links": ["Details", "Locations", "Support", "Data", "Custom"], "screenshot": "screenshots/edit-design.png"},
    {"name": "Card Editor - Details", "url": "/edit/:campaignId/details", "nav": "editor tab",
     "purpose": "Card copy, reward definition, expiry, useful links",
     "features": [
       {"name": "Card text fields", "type": "form", "does": "Description, earn-stamp text, business name", "entities": ["campaign"]},
       {"name": "Reward details", "type": "form", "does": "Reward name, description, stamp success msg ({#} placeholder), reward success msg", "entities": ["reward"]},
       {"name": "Expiry", "type": "radio", "does": "None / Fixed date / Fixed period after signup", "entities": ["campaign.expiry"]},
       {"name": "Useful links", "type": "table", "does": "Text, Link, Type (Url/Phone/Email/Address)", "entities": ["campaign.links"]}],
     "screenshot": "screenshots/edit-details.png"},
    {"name": "Card Editor - Locations", "url": "/edit/:campaignId/locations", "nav": "editor tab",
     "purpose": "Attach locations/beacons for lock-screen messages",
     "features": [
       {"name": "Locations table", "type": "table", "does": "Location, Address on Card, Display, Message", "entities": ["location", "campaign"]},
       {"name": "Beacons table", "type": "table", "does": "Beacon, Message", "entities": ["beacon", "campaign"]}],
     "api": ["GET /locations"], "screenshot": "screenshots/edit-locations.png"},
    {"name": "Card Editor - Support", "url": "/edit/:campaignId/support", "nav": "editor tab",
     "purpose": "T&C and issuer contact info",
     "features": [
       {"name": "Terms & Conditions", "type": "form", "does": "Enabled checkbox, textarea, external T&C link", "entities": ["campaign"]},
       {"name": "Card Issuer Details", "type": "form", "does": "Business name, email, phone", "entities": ["account"]}],
     "screenshot": "screenshots/edit-support.png"},
    {"name": "Card Editor - Data", "url": "/edit/:campaignId/data", "nav": "editor tab",
     "purpose": "Enrollment data collection config",
     "features": [
       {"name": "Data Collection", "type": "table", "does": "Description/Format/Mandatory fields for enrollment form", "entities": ["campaign.dataFields"]},
       {"name": "Default country", "type": "filter", "does": "Country for phone fields", "entities": ["campaign"]},
       {"name": "Unique enrollments", "type": "form", "does": "Dedupe by up to 3 unique fields", "entities": ["customer"]},
       {"name": "Data Consent", "type": "form", "does": "Marketing consent text + default-checked", "entities": ["campaign"]},
       {"name": "Enrollment preview", "type": "chart", "does": "Live landing page preview", "entities": ["campaign"]}],
     "screenshot": "screenshots/edit-data.png"},
    {"name": "Card Editor - Custom (Labels)", "url": "/edit/:campaignId/labels", "nav": "editor tab",
     "purpose": "Custom fields and label text overrides",
     "features": [
       {"name": "Add Custom Fields", "type": "table", "does": "Label -> Field to Display (stamps, totals, name, email, mobile)", "entities": ["campaign.customFrontFields"]},
       {"name": "Card Labels", "type": "table", "does": "Override ~20 default label strings", "entities": ["campaign"]}],
     "screenshot": "screenshots/edit-custom.png"},
    {"name": "Dashboard", "url": "/dash", "nav": "top-bar Dashboard",
     "purpose": "Account-level totals and acquisition trend",
     "features": [
       {"name": "Total statistics", "type": "chart", "does": "Customers Enrolled, Stamps Issued, Rewards Issued, Rewards Redeemed", "entities": ["campaign", "customer"]},
       {"name": "Acquisition", "type": "chart", "does": "Group by Day/Month/Year", "entities": ["customer"]},
       {"name": "Rewards Overview", "type": "chart", "does": "Reward summary", "entities": ["reward"]}],
     "api": ["GET /events/analytics/all/:campaignId"], "screenshot": "screenshots/dash.png"},
    {"name": "Overview", "url": "/overview/:campaignId", "nav": "campaign rail Overview",
     "purpose": "Live campaign health and share URL",
     "features": [
       {"name": "KPIs", "type": "chart", "does": "Customers Signed Up, Stamps Issued, Rewards Issued, Rewards Redeemed", "entities": ["campaign", "customer"]},
       {"name": "Latest Transactions", "type": "table", "does": "Date/Time, Customer, Event, User; pagination + search", "entities": ["event"]},
       {"name": "Push Message History", "type": "table", "does": "Date, Message, Segment, Reach", "entities": ["message"]},
       {"name": "Card URL", "type": "action button", "does": "loyalty.is link, Copy link, QR code", "entities": ["campaign"]}],
     "api": ["GET /events/analytics/all/:id", "GET /events/pushHistory/:id", "POST /events/analytics/transactions/:id"], "screenshot": "screenshots/overview.png"},
    {"name": "Insights", "url": "/insights/:campaignId", "nav": "rail Insights",
     "purpose": "Revenue vs reward cost ROI",
     "features": [
       {"name": "Revenue/cost summary", "type": "chart", "does": "Revenue driven, reward cost, claimed vs outstanding", "entities": ["reward", "event"]},
       {"name": "All time stats", "type": "chart", "does": "Signups, stamps, rewards issued", "entities": ["event"]},
       {"name": "Currency", "type": "filter", "does": "ISO currency selector", "entities": ["campaign"]}],
     "api": ["GET /events/analytics/all/:id", "GET /events/analytics/stampTotals/:id", "POST /events/analytics/transactions/:id"], "screenshot": "screenshots/insights.png"},
    {"name": "Messages", "url": "/messages/:campaignId", "nav": "campaign rail Messages",
     "purpose": "Push messages to card holders",
     "features": [
       {"name": "Audience selector", "type": "filter", "does": "All customers or a segment", "entities": ["customer", "segment"]},
       {"name": "Message composer", "type": "form", "does": "Text + best practice hint + ideas", "entities": ["message"]},
       {"name": "Send Message", "type": "action button", "does": "Sends push", "entities": ["message"]},
       {"name": "Push history", "type": "table", "does": "Date, Message, Segment, Reach", "entities": ["message"]}],
     "api": ["GET /card/cid/:id?count=true"], "screenshot": "screenshots/messages.png"},
    {"name": "Customers", "url": "/customers/:campaignId", "nav": "campaign rail Customers",
     "purpose": "Enrolled customer list",
     "features": [{"name": "Customers table", "type": "table", "does": "First Name, Email, Mobile, Signup Date, Card Status, Stamps/Rewards Earned/Redeemed; pagination + search", "entities": ["customer", "card"]}],
     "api": ["POST /card/cid/:id?count=false"], "links": ["/customers/:campaignId/profile/:cardId"], "screenshot": "screenshots/customers.png"},
    {"name": "Subusers", "url": "/subusers", "nav": "rail Subusers",
     "purpose": "Staff accounts for stamping/redeeming with attribution",
     "features": [
       {"name": "Create Subuser", "type": "form", "does": "Modal: Username, Password, Notes, Location", "entities": ["subuser"]},
       {"name": "Subusers table", "type": "table", "does": "Profile, Username, Created, Notes, Location, Status", "entities": ["subuser"]}],
     "api": ["GET /subusers", "GET /locations"], "links": ["/subuser/:subuserId"], "screenshot": "screenshots/subusers.png"},
    {"name": "Settings", "url": "/settings", "nav": "top-bar Settings / Upgrade Now",
     "purpose": "Account, billing, locations, beacons, integrations",
     "features": [
       {"name": "My Account tabs", "type": "form", "does": "General, Business, Privacy, Password, Developer Tools (API key/secret), Delete", "entities": ["account"]},
       {"name": "Billing", "type": "form", "does": "Plan (Starter $25 / Growth $69 / Ultimate $95, monthly/annual), Credit Card (Stripe), Invoices", "entities": ["account", "plan"]},
       {"name": "Locations", "type": "form", "does": "Add Location with Google Maps picker", "entities": ["location"]},
       {"name": "Beacons", "type": "form", "does": "Add Beacon", "entities": ["beacon"]},
       {"name": "Zapier", "type": "table", "does": "Embedded workflow gallery (Mailchimp, Google Sheets)", "entities": ["integration"]}],
     "api": ["GET /account", "GET /locations", "Stripe"], "screenshot": "screenshots/settings.png"},
    {"name": "Landing Page (customer)", "url": "/landing-page/:campaignId", "nav": "loyalty.is share URL / QR",
     "purpose": "Customer enrollment form",
     "features": [{"name": "Enrollment form", "type": "form", "does": "Fields per Data tab (First Name, Email, Mobile), T&C checkbox, Join Now!", "entities": ["customer", "card"]}],
     "api": ["GET /campaign/public/:id"], "screenshot": "screenshots/landing-page.png"},
    {"name": "Stamp", "url": "/stamp", "nav": "staff tool",
     "purpose": "Stamp a customer card by ID/scan",
     "features": [{"name": "Card ID + Stamp Card!", "type": "form", "does": "Enter/scan card ID and stamp", "entities": ["card", "stamp"]}],
     "screenshot": "screenshots/stamp.png"},
    {"name": "Help / Templates", "url": "/help", "nav": "rail Start (rocket)",
     "purpose": "Template gallery to start a new card",
     "features": [
       {"name": "Choose a Template", "type": "table", "does": "Cafe/Restaurant/Retail/Salon/Entertainment/Instructor/Service/Blank templates", "entities": ["campaign"]},
       {"name": "Resources", "type": "action button", "does": "Quick Start Guide, Tutorials & Support, Stamper App links", "entities": []}],
     "api": ["GET /images/stampTemplates"], "screenshot": "screenshots/help-templates.png"}
  ],
  "unverified_routes": ["/customers/:campaignId/profile/:cardId", "/subuser/:subuserId", "/invoice/:invoiceId", "/csv-verify/:file", "/login", "/signup", "/get-started", "/setup", "/account", "/verify/:code", "/forgot-password", "/reset-password/:username/:code", "/renew-subscription", "/404"],
  "notes": [
    "Activation of a card is blocked until the account email is verified; live-only behaviors (segments, stamping against real cards, rail enablement) are UNVERIFIED.",
    "Campaign rail (Overview/Insights/Messages/Customers/Edit) is disabled while the selected campaign is a draft (status != 2); pages are still reachable via ui-router $state.go.",
    "Manage My Cards card tiles intermittently render empty on reload (UI bug).",
    "Screenshots directory: /Users/fahad/council/output/screenshots/."
  ]
}
