  "entity_model": {
    "account": {"fields": ["username", "name", "email", "business info", "billing", "plan", "API key/secret", "locations", "beacons", "subusers"], "plans": ["Starter", "Growth", "Ultimate"]},
    "campaign": {"aka": "card", "fields": ["type (single/multi reward)", "design (images, stamps 1-25, colors)", "details (description, earn rule, rewards[], expiry, links[])", "locations[]", "beacons[]", "support (terms, issuer)", "data fields[] + consent + unique-enrollment", "custom fields[] + labels[]"], "status_flow": ["DRAFT", "ACTIVATION (requires verified email)", "LIVE"], "deletable": true},
    "customer": {"enrolls_via": "/landing-page/:campaignId", "receives": "wallet pass (Apple/Google) via loyalty.is link/QR", "card_has": ["stamps", "rewards earned", "rewards redeemed", "status"]},
    "stamp": {"issued_by": "owner/subuser via Stamper App or /stamp", "tracked_in": ["Overview transactions", "Insights", "Customer profile"]},
    "reward": {"defined_in": "campaign.rewards[] (name, text, lockscreen messages, cost)", "earned": "at stamp threshold", "redeemed": "by staff"},
    "message": {"audience": ["all customers", "segment"], "surfaces": ["lock screen", "Latest Updates on pass"], "history_tracked": true},
    "location": {"used_for": "lock-screen proximity messages", "managed": "account-level + per-card"},
    "beacon": {"fields": ["name", "UUID", "major", "minor"], "used_for": "bluetooth proximity messages"}
  },
  "api_endpoints": {
    "observed": [
      "POST /account/login",
      "GET /account",
      "GET /campaigns",
      "GET /campaign/exists/:name",
      "POST /campaign",
      "GET /campaign/id/:id",
      "POST /events/analytics/transactions/:campaignId",
      "GET /events/analytics/all/:campaignId",
      "GET /events/analytics/stampTotals/:campaignId",
      "GET /events/pushHistory/:campaignId",
      "POST /card/cid/:campaignId",
      "GET /subusers",
      "GET /locations",
      "GET /beacons"
    ],
    "source_derived_unverified": [
      "GET /events/analytics/rewardTotals/:campaignId",
      "POST /card/push",
      "/campaign/public/",
      "/images/stampTemplates",
      "/images/stampImage/",
      "/account/cardIntent/",
      "/location/",
      "/beacon/",
      "/subuser/",
      "/push",
      "/intercom/message/",
      "/api/people"
    ]
  },
  "integrations": ["Stripe (billing)", "Google Maps + Places (locations)", "Intercom (support widget)", "Cloudflare Turnstile", "Google Analytics / GTM", "Facebook Pixel", "Microsoft Clarity", "Tapfiliate", "ProfitWell", "Vimeo (tutorials)", "YouTube (Video Academy)", "Zapier", "PassKit (pass infrastructure)"]
}
